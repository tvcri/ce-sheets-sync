# Email Configuration (Required)
# The email address where Club Express sends automated reports
EMAIL_ADDRESS=your-email@example.com

# The password for the email account
# SECURITY WARNING: Keep this secret. Use an app-specific password if available.
EMAIL_PASSWORD=your-secure-password

# IMAP server settings (adjust if using a different email provider)
IMAP_HOST=imap.your-email-provider.com
IMAP_PORT=993

# Google Sheets Configuration (Required)
# Path to the OAuth client secret JSON (downloaded from Google Cloud Console)
OAUTH_CLIENT_SECRET_FILE=tokens/client_secret_*.apps.googleusercontent.com.json

# Path to the OAuth refresh token (created after first login)
OAUTH_TOKEN_FILE=tokens/oauth-token.json

# Polling Settings (Optional - adjust for your schedule)
# How often to check for new emails during the "fast" phase (in milliseconds)
# Default: 30000 (30 seconds)
POLL_FAST_INTERVAL_MS=30000

# How long to stay in "fast" polling before slowing down (in milliseconds)
# Default: 300000 (5 minutes)
POLL_FAST_DURATION_MS=300000

# How often to check for emails during the "slow" phase (in milliseconds)
# Default: 60000 (60 seconds)
POLL_SLOW_INTERVAL_MS=60000

# How long to stay in "slow" polling before giving up (in milliseconds)
# Default: 3000000 (50 minutes) - total poll time = fast + slow = ~55 minutes
POLL_SLOW_DURATION_MS=3000000

# Testing & Development (Optional)
# Use development sheets instead of production sheets
# Set to "true" to use dev sheet IDs; default is false (production)
# USE_DEV_SHEETS=false

# Comma-separated list of metro areas to sync (if not set, all 14 areas are synced)
# Examples: "Aquidneck" or "Aquidneck,Providence"
# METRO_AREAS=Aquidneck

# If set, process a local CSV file instead of polling email
# Example: CSV_FILE=scratch/dump-chain.csv
# CSV_FILE=

# If set, write to this test spreadsheet instead of the real ones
# MUST be used with METRO_AREAS set
# TEST_SPREADSHEET_ID=

# Village Green Integration (Optional)
# After a successful database sync, POST to this URL to notify the Village Green API
# If not set, the webhook step is skipped silently
# VG_SYNC_WEBHOOK_URL=https://api.villagegreen.example.com/webhooks/ce-sync

# Bearer token sent in the Authorization header when calling the webhook
# VG_SYNC_WEBHOOK_KEY=your-webhook-secret-key

# Database Configuration (Optional)
# MySQL connection settings for Village Green backend
# Default: localhost:60001, user 'vg', password 'vgpw', database 'vg'
# DB_HOST=127.0.0.1
# DB_PORT=60001
# DB_USER=vg
# DB_PASSWORD=vgpw
# DB_NAME=vg

# JotForm FCV sync (optional — omit to skip FCV sync)
# JOTFORM_API_KEY=your_jotform_api_key
# JOTFORM_FORM_ID=your_form_id

# Anthropic API key for fuzzy name matching in FCV sync (optional — omit to skip fuzzy matching)
# ANTHROPIC_API_KEY=your_anthropic_api_key
